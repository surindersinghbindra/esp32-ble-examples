# Enable the BLE stack (NimBLE host, no Bluedroid/BR-EDR)
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4000

# Negotiate a large ATT MTU so OTA data chunks aren't limited to ~20 bytes
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

# Educational pairing/bonding example (see main.c's ble_hs_cfg.sm_* setup and
# led_service.c's encrypted characteristic): without this, a bond only lasts
# until disconnect - the device would ask to pair again on every reconnect.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Lets main.c call ble_sm_configure_static_passkey() so this device can use
# Passkey Entry pairing (see main/Kconfig.projbuild's BLE_OTA_PAIRING_PASSKEY
# for the actual 6-digit value, changeable via `idf.py menuconfig`).
CONFIG_BT_NIMBLE_STATIC_PASSKEY=y

# Educational fast-update path: lets ota_service open an L2CAP CoC channel
# (see the big comment in ota_service.c) as an alternative to the GATT Data
# characteristic for bulk firmware bytes.
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=1

# Dual-slot OTA partition table: ota_0 + ota_1 only, no factory partition.
# Whichever slot is NOT currently running is always the OTA target, so a
# bad update can never overwrite the only bootable image.
# Requires 4MB+ flash (this board has 8MB, so there's headroom to spare).
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Safety net: after an OTA update, the new image boots in a "pending verify"
# state. If app_main() doesn't explicitly confirm it (see main.c) before the
# next reset - including a crash or watchdog reset - the bootloader
# automatically reverts to the previous, known-good OTA slot instead of
# retrying the broken one. This is what actually prevents an OTA update from
# bricking the board.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
